---
import Layout from '../layouts/Layout.astro';
import { Show } from '@clerk/astro/components';
---

<Layout title="AI-zeru — Zoltraak Spellcasting AI Terminal">
  <main class="landing-wrapper">
    <!-- Animated background runes -->
    <div class="rune-bg" aria-hidden="true">
      <div class="rune rune-1">⟨ ψ ⟩</div>
      <div class="rune rune-2">∑ λ ∞</div>
      <div class="rune rune-3">⌬ ◈ ⌬</div>
      <div class="rune rune-4">◊ Ω ◊</div>
      <div class="rune rune-5">⟪ Σ ⟫</div>
      <div class="rune rune-6">∇ φ ∇</div>
    </div>

    <!-- macOS Window Container -->
    <div class="window-frame landing-window">
      <!-- Title Bar -->
      <div class="title-bar">
        <div class="traffic-lights">
          <button class="tl tl-red" aria-label="Close" title="Close"></button>
          <button class="tl tl-yellow" aria-label="Minimize" title="Minimize"></button>
          <button class="tl tl-green" aria-label="Maximize" title="Maximize"></button>
        </div>
        <div class="title-bar-text">
          <span class="mono-text">~/aizeru — Spellcasting Terminal v3.3</span>
        </div>
        <div class="title-bar-spacer"></div>
      </div>

      <!-- Window Content -->
      <div class="landing-content">
        <!-- Logo area -->
        <div class="logo-section">
          <div class="glyph-ring">
            <div class="glyph-inner">
              <span class="glyph-symbol">ψ</span>
            </div>
            <div class="ring ring-outer"></div>
            <div class="ring ring-middle"></div>
          </div>

          <div class="title-group">
            <h1 class="app-title">AI-zeru</h1>
            <p class="app-subtitle">Zoltraak Spellcasting AI Terminal</p>
          </div>
        </div>

        <!-- Description -->
        <div class="description-card">
          <div class="terminal-prompt">
            <span class="prompt-symbol">❯</span>
            <span class="prompt-text">system.initialize()</span>
          </div>
          <p class="desc-text">
            Channel the arcane power of <strong class="accent-text">Groq Llama-3.3-70b</strong> — the fastest 
            large language model in the realm. Cast spells of intelligence, conjure answers from the void, 
            and command AI with medieval mastery.
          </p>
          <div class="feature-tags">
            <span class="tag">⚡ Groq Ultra-Fast</span>
            <span class="tag">🔮 Llama-3.3-70b</span>
            <span class="tag">📜 Chat History</span>
            <span class="tag">🛡️ Clerk Auth</span>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="cta-section">
          <Show when="signed-out">
            <a href="/sign-in" class="btn btn-primary" id="cta-login">
              <span class="btn-icon">⚡</span>
              Cast Spell — Login with Clerk
            </a>
            <a href="/sign-up" class="btn btn-secondary" id="cta-signup">
              <span class="btn-icon">✦</span>
              Create Grimoire Account
            </a>
          </Show>
          <Show when="signed-in">
            <a href="/dashboard" class="btn btn-primary" id="cta-dashboard">
              <span class="btn-icon">🌌</span>
              Enter the Spellroom
            </a>
          </Show>
        </div>

        <!-- Status bar -->
        <div class="status-bar">
          <span class="status-dot active"></span>
          <span class="status-text mono-text">AI Engine: Groq Llama-3.3-70b-versatile | Mana: 100% | Realm: Online</span>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .landing-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    position: relative;
    overflow: hidden;
  }

  /* Animated rune background */
  .rune-bg {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .rune {
    position: absolute;
    font-family: var(--font-mono);
    color: var(--accent-glow-soft);
    font-size: clamp(1rem, 2vw, 1.5rem);
    letter-spacing: 0.5em;
    opacity: 0;
    animation: floatRune 15s ease-in-out infinite;
    user-select: none;
  }

  .rune-1 { top: 10%; left: 5%; animation-delay: 0s; font-size: 1.2rem; }
  .rune-2 { top: 25%; right: 8%; animation-delay: 2.5s; font-size: 1rem; }
  .rune-3 { bottom: 30%; left: 3%; animation-delay: 5s; font-size: 1.4rem; }
  .rune-4 { bottom: 15%; right: 5%; animation-delay: 7.5s; font-size: 1.1rem; }
  .rune-5 { top: 60%; left: 10%; animation-delay: 10s; font-size: 0.9rem; }
  .rune-6 { top: 5%; right: 15%; animation-delay: 12.5s; font-size: 1.3rem; }

  @keyframes floatRune {
    0%, 100% { opacity: 0; transform: translateY(20px); }
    20%, 80% { opacity: 0.4; transform: translateY(0); }
    50% { opacity: 0.6; }
  }

  /* macOS Window Frame */
  .window-frame {
    position: relative;
    z-index: 1;
    background: var(--bg-glass);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid var(--border-accent);
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px var(--border-subtle),
      0 25px 60px rgba(0, 0, 0, 0.6),
      0 0 60px var(--accent-glow-soft),
      inset 0 1px 0 rgba(255, 255, 255, 0.07);
    animation: windowAppear 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes windowAppear {
    from { opacity: 0; transform: scale(0.92) translateY(20px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .landing-window {
    width: 100%;
    max-width: 680px;
  }

  /* Title Bar */
  .title-bar {
    display: flex;
    align-items: center;
    padding: 0.75rem 1rem;
    background: rgba(0, 0, 0, 0.35);
    border-bottom: 1px solid var(--border-subtle);
    gap: 0.75rem;
  }

  .traffic-lights {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .tl {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    transition: filter 0.2s, transform 0.1s;
    position: relative;
  }

  .tl:hover {
    filter: brightness(1.3);
    transform: scale(1.1);
  }

  .tl-red { background-color: var(--tl-red); box-shadow: 0 0 8px rgba(255, 95, 87, 0.5); }
  .tl-yellow { background-color: var(--tl-yellow); box-shadow: 0 0 8px rgba(254, 188, 46, 0.4); }
  .tl-green { background-color: var(--tl-green); box-shadow: 0 0 8px rgba(40, 200, 64, 0.4); }

  .title-bar-text {
    flex: 1;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .title-bar-spacer {
    width: 52px;
    flex-shrink: 0;
  }

  /* Landing Content */
  .landing-content {
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;
  }

  /* Logo / Glyph Section */
  .logo-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .glyph-ring {
    position: relative;
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .glyph-inner {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 212, 255, 0.15), rgba(0, 0, 0, 0));
    border: 2px solid var(--accent-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
    box-shadow: 0 0 20px var(--accent-glow), inset 0 0 20px rgba(0, 212, 255, 0.1);
    animation: pulse-glow 3s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 20px var(--accent-glow), inset 0 0 20px rgba(0, 212, 255, 0.1); }
    50% { box-shadow: 0 0 40px var(--accent-glow), inset 0 0 30px rgba(0, 212, 255, 0.2); }
  }

  .glyph-symbol {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    color: var(--accent-primary);
    text-shadow: 0 0 20px var(--accent-primary);
  }

  .ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid var(--border-accent);
    animation: rotateRing 8s linear infinite;
  }

  .ring-outer {
    width: 100px;
    height: 100px;
    border-color: rgba(0, 212, 255, 0.15);
    animation-duration: 12s;
  }

  .ring-middle {
    width: 82px;
    height: 82px;
    border-color: rgba(0, 212, 255, 0.2);
    animation-direction: reverse;
    animation-duration: 8s;
  }

  @keyframes rotateRing {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .title-group {
    text-align: center;
  }

  .app-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 700;
    background: linear-gradient(135deg, #fff 0%, var(--accent-primary) 50%, var(--accent-silver) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 0.05em;
    text-shadow: none;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .app-subtitle {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-secondary);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Description card */
  .description-card {
    background: var(--bg-glass-light);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.5rem;
    width: 100%;
  }

  .terminal-prompt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .prompt-symbol {
    color: var(--accent-primary);
    text-shadow: 0 0 10px var(--accent-primary);
  }

  .prompt-text {
    color: var(--text-secondary);
  }

  .desc-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .accent-text {
    color: var(--accent-primary);
    font-weight: 600;
    text-shadow: 0 0 10px var(--accent-glow);
  }

  .feature-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    background: rgba(0, 212, 255, 0.06);
    border: 1px solid var(--border-accent);
    border-radius: 20px;
    padding: 0.25rem 0.75rem;
    white-space: nowrap;
  }

  /* CTA Buttons */
  .cta-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.875rem 1.5rem;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    border: none;
  }

  .btn::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--accent-secondary), var(--accent-primary));
    color: #000;
    box-shadow: 0 0 20px var(--accent-glow), 0 4px 15px rgba(0, 0, 0, 0.3);
  }

  .btn-primary::before {
    background: rgba(255, 255, 255, 0.15);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 35px var(--accent-glow), 0 8px 25px rgba(0, 0, 0, 0.4);
  }

  .btn-primary:hover::before {
    opacity: 1;
  }

  .btn-secondary {
    background: var(--bg-glass-light);
    color: var(--text-primary);
    border: 1px solid var(--border-accent);
    backdrop-filter: blur(8px);
  }

  .btn-secondary:hover {
    background: rgba(0, 212, 255, 0.08);
    border-color: var(--accent-primary);
    transform: translateY(-1px);
    box-shadow: 0 0 15px var(--accent-glow-soft);
  }

  .btn-icon {
    font-size: 1rem;
  }

  /* Status bar */
  .status-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--tl-green);
    flex-shrink: 0;
  }

  .status-dot.active {
    box-shadow: 0 0 8px rgba(40, 200, 64, 0.6);
    animation: dotPulse 2s ease-in-out infinite;
  }

  @keyframes dotPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .status-text {
    font-size: 0.7rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .mono-text {
    font-family: var(--font-mono);
  }

  @media (max-width: 480px) {
    .landing-content {
      padding: 2rem 1.25rem;
    }
    .app-title {
      font-size: 2rem;
    }
  }
</style>
